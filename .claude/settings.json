{
  "mcpServers": {
    "codexkit": {
      "args": [
        "bash",
        "-lc",
        "exec \"$PWD/scripts/run-codexkit-mcp.sh\""
      ],
      "command": "/usr/bin/env"
    }
  },
  "permissions": {
    "allow": [
      "mcp__codexkit__baseline_check",
      "mcp__codexkit__baseline_check_all",
      "mcp__codexkit__fleet_audit",
      "mcp__codexkit__fleet_report",
      "mcp__codexkit__mcp_diff",
      "mcp__codexkit__mcp_list",
      "mcp__codexkit__skill_diff",
      "mcp__codexkit__skill_list"
    ]
  }
}
