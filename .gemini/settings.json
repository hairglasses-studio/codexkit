{
  "context": {
    "fileName": [
      "AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md"
    ]
  },
  "mcp": {
    "allowed": [
      "codexkit"
    ]
  },
  "mcpServers": {
    "codexkit": {
      "args": [
        "bash",
        "-lc",
        "exec \"$PWD/scripts/run-codexkit-mcp.sh\""
      ],
      "command": "/usr/bin/env"
    }
  }
}
